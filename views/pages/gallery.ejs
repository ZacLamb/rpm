<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-hero page-hero--short">
  <div class="page-hero__media"><img src="<%= img('wine-rooms').src %>" alt="<%= img('wine-rooms').alt %>"></div>
  <div class="page-hero__shade"></div>
  <div class="wrap page-hero__in">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Our Work</span></nav>
    <h1>Real projects, real results</h1>
    <p class="hero__sub">A look at the kind of work that leaves our shop every week.</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="gallery">
      <% keys.forEach(k => { %><figure class="gallery__item reveal"><img src="<%= img(k).src %>" alt="<%= img(k).alt %>" loading="lazy"><figcaption><%= img(k).alt %></figcaption></figure><% }) %>
    </div>
  </div>
</section>
<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
