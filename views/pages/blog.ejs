<% extraSchema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" }, { "@type": "ListItem", "position": 2, "name": "Blog", "item": siteUrl + "/blog" } ].concat(topicService ? [{ "@type": "ListItem", "position": 3, "name": topicService.name, "item": siteUrl + base }] : []) },
  { "@context": "https://schema.org", "@type": "Blog", "name": "RPM Glass Blog", "url": siteUrl + "/blog", "publisher": { "@id": siteUrl + "/#business" } }
] %>
<%- include('../partials/head') %>
<% if (page > 1) { %><link rel="prev" href="<%= base %><%= page > 2 ? '?page=' + (page - 1) : '' %>"><% } %>
<% if (page < pages) { %><link rel="next" href="<%= base %>?page=<%= page + 1 %>"><% } %>
<%- include('../partials/header') %>

<section class="page-hero page-hero--short">
  <div class="page-hero__media"><img src="<%= img(topicService ? topicService.slug : 'hero').src %>" alt="" width="<%= img('hero').w %>" height="<%= img('hero').h %>"></div>
  <div class="page-hero__shade"></div>
  <div class="wrap page-hero__in">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <% if (topicService) { %><a href="/blog">Blog</a> / <span><%= topicService.short %></span><% } else { %><span>Blog</span><% } %></nav>
    <h1><%= topicService ? topicService.name + ' Guides' : 'Glass Tips & Guides' %></h1>
    <p class="hero__sub">Straight answers on commercial and residential glass from the RPM Glass crew in Northborough, MA.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="chips blog-filter">
      <a class="chip <%= !topicService ? 'chip--on' : '' %>" href="/blog">All articles</a>
      <% services.filter(s => blogTopics.includes(s.slug)).forEach(s => { %><a class="chip <%= topicService && topicService.slug === s.slug ? 'chip--on' : '' %>" href="/blog/topic/<%= s.slug %>"><%= s.short %></a><% }) %>
    </div>
    <div class="cards cards--3">
      <% posts.forEach(p => { const im = img(p.image_key || 'hero'); %>
      <a class="card" href="/blog/<%= p.slug %>">
        <div class="card__media"><img src="<%= im.src %>" alt="" width="<%= im.w %>" height="<%= im.h %>" loading="lazy"><% if (p.town_slug) { %><span class="card__tag">Local guide</span><% } %></div>
        <div class="card__body">
          <small class="muted"><%= new Date(p.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }) %></small>
          <h3><%= p.title %></h3>
          <p><%= p.excerpt %></p>
          <span class="card__more">Read article →</span>
        </div>
      </a>
      <% }) %>
    </div>
    <% if (pages > 1) { %>
    <nav class="pager" aria-label="Pagination">
      <% if (page > 1) { %><a class="btn btn--primary" href="<%= base %><%= page > 2 ? '?page=' + (page - 1) : '' %>">← Newer</a><% } %>
      <span>Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %><a class="btn btn--primary" href="<%= base %>?page=<%= page + 1 %>">Older →</a><% } %>
    </nav>
    <% } %>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
