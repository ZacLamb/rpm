<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>RPM Glass - Commercial & Residential Glass Solutions</title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'RPM Glass delivers excellence in glass design, installation, and repair. Serving Massachusetts with over 12 years of experience in commercial and residential glass solutions.' %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="https://assets.cdn.filesafe.space/gqZLaxiRnT93o0AopLh3/media/d654685c-1804-4c9d-97aa-0671aee0fe59.png">
</head>
<body>
  <header class="header">
    <div class="container">
      <a href="/" class="logo">
        <img src="https://assets.cdn.filesafe.space/gqZLaxiRnT93o0AopLh3/media/d654685c-1804-4c9d-97aa-0671aee0fe59.png" alt="RPM Glass Logo">
        <span class="logo-text">RPM Glass</span>
      </a>
      <nav class="nav">
        <ul class="nav-links">
          <li><a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a></li>
          <li><a href="/about" class="<%= currentPage === 'about' ? 'active' : '' %>">About</a></li>
          <li class="dropdown">
            <a href="/services" class="<%= currentPage === 'services' ? 'active' : '' %>">Services</a>
            <div class="dropdown-content">
              <% services.forEach(service => { %>
                <a href="/services/<%= service.slug %>"><%= service.name %></a>
              <% }); %>
            </div>
          </li>
          <li><a href="/gallery" class="<%= currentPage === 'gallery' ? 'active' : '' %>">Gallery</a></li>
          <li><a href="/contact" class="<%= currentPage === 'contact' ? 'active' : '' %>">Contact</a></li>
        </ul>
        <a href="tel:+17744569850" class="cta-button">
          📞 <%= company.phone %>
        </a>
        <div class="mobile-toggle">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </nav>
    </div>
  </header>
