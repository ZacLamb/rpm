</main>
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a class="logo logo--light" href="/"><span class="logo__text">RPM <em>Glass</em></span></a>
      <p>Commercial and residential glass design, installation and repair — trusted across Worcester County and MetroWest for over <%= business.yearsInBusiness %> years.</p>
      <a class="footer__phone" href="<%= business.phoneHref %>"><%= business.phone %></a>
      <p class="footer__addr"><%= business.street %><br><%= business.city %>, <%= business.state %> <%= business.zip %><br><a href="mailto:<%= business.email %>"><%= business.email %></a></p>
      <div class="footer__social"><a href="<%= business.instagram %>" target="_blank" rel="noopener">Instagram</a></div>
    </div>
    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/services">All Services</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li><a href="/gallery">Our Work</a></li>
        <li><a href="/contact">Contact &amp; Free Estimate</a></li>
      </ul>
    </div>
    <div>
      <h4>Our Services</h4>
      <ul>
        <% services.forEach(s => { %><li><a href="/services/<%= s.slug %>"><%= s.name %></a></li><% }) %>
      </ul>
    </div>
    <div>
      <h4>Towns We Serve</h4>
      <ul class="footer__towns">
        <% towns.forEach(t => { %><li><a href="/service-areas/<%= t.slug %>"><%= t.name %>, MA</a></li><% }) %>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <span>© <%= year %> <%= business.name %>. All rights reserved. Fully licensed &amp; insured in Massachusetts.</span>
    <span><a href="/sitemap.xml">Sitemap</a></span>
  </div>
</footer>
<a class="mobile-call" href="<%= business.phoneHref %>" aria-label="Call RPM Glass">Call Now · <%= business.phone %></a>
<script src="/js/main.js" defer></script>
</body>
</html>
