  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <img src="https://assets.cdn.filesafe.space/gqZLaxiRnT93o0AopLh3/media/d654685c-1804-4c9d-97aa-0671aee0fe59.png" alt="RPM Glass Logo" style="height: 60px;">
          </a>
          <p>Delivering excellence in glass design, installation, and repair for over 12 years. Trust RPM Glass for all your commercial and residential glass needs.</p>
        </div>
        <div>
          <h4 class="footer-title">Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/gallery">Gallery</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4 class="footer-title">Services</h4>
          <ul class="footer-links">
            <% services.slice(0, 6).forEach(service => { %>
              <li><a href="/services/<%= service.slug %>"><%= service.name %></a></li>
            <% }); %>
          </ul>
        </div>
        <div>
          <h4 class="footer-title">Contact Us</h4>
          <ul class="footer-links">
            <li><a href="tel:+17744569850"><%= company.phone %></a></li>
            <li><a href="mailto:<%= company.email %>"><%= company.email %></a></li>
            <li><%= company.address %></li>
            <li style="margin-top: 15px;">
              <a href="<%= company.instagram %>" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px;">
                📷 Follow us on Instagram
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> RPM Glass. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
